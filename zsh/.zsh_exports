#!/usr/bin/bash

[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"

export VISUAL=vi
export EDITOR="$VISUAL"
# export TERMINAL=st

# fix tmux icon rendering
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/.local/share/pnpm"

PATH=$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH
PATH=$HOME/go/bin/:$PATH
PATH="$BUN_INSTALL/bin:$PATH"
PATH="$PNPM_HOME:$PATH"
PATH="/Users/amar/.pixi/bin:$PATH"
PATH="/Users/amar/.sst/bin:$PATH"

# fix matplotlib
export LD_PRELOAD=/usr/lib/libstdc++.so.6

# export LESS=-c

# node version manager
if [[ "$OSTYPE" != "linux-gnu" ]]; then
  export PATH="/Users/amar/Library/Application Support/fnm:$PATH"
fi

export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"

# Directory-scoped env overrides (see .zsh_workspace_env.zsh)
export ZSH_WORKSPACES_CONF="$HOME/.dotfiles/zsh/workspaces.conf"
export ZSH_WORKSPACES_DIR="$HOME/.dotfiles/zsh/workspaces"

# This should be the last line
export PATH
export WORKON_HOME=~/Library/Python/virtualenv
